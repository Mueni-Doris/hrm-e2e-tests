# STAGING ONLY — the config refuses to run if these URLs don't contain "staging".
STAGING_BASE_URL=https://hr-app-frontend-staging.staging.kiotapay.com
STAGING_AUTH_URL=https://auth-app-ui-staging.staging.kiotapay.com

# Applicant (employee) account
EMPLOYEE_USERNAME=
EMPLOYEE_PASSWORD=
# Display name as shown in the approver's pending list (optional, used for diagnostics)
EMPLOYEE_NAME=

# Approver / HR admin account — must be configured as the (single) approver for EMPLOYEE's job
APPROVER_USERNAME=
APPROVER_PASSWORD=

# Leave type names exactly as shown in the "Leave Type" dropdown
LEAVE_TYPE=

# Leave dates are generated automatically from today's date (always in the future).
